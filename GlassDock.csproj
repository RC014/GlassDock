<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- ManagedShell uses Windows Forms internally; without this a self-contained build leaves it out and crashes. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\GlassDock.ico</ApplicationIcon>
    <AssemblyName>GlassDock</AssemblyName>
    <RootNamespace>GlassDock</RootNamespace>
    <Version>1.3.2</Version>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <!-- WMI, for the Quick Settings brightness slider -->
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- Compiled from Shaders\*.fx with: fxc /T ps_2_0 /E main /O3 /Fo Shaders\X.ps Shaders\X.fx (Windows SDK) -->
    <Resource Include="Shaders\Lens.ps" />
    <Resource Include="Shaders\Blur.ps" />
    <!-- logo (assets\make-icon.ps1 draws it): exe icon above, window icon at runtime -->
    <Resource Include="assets\GlassDock.ico" />
  </ItemGroup>

  <!-- The installer is a separate project in Installer\; keep its files out of the app. -->
  <ItemGroup>
    <Compile Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
    <Page Remove="Installer\**" />
  </ItemGroup>

</Project>


