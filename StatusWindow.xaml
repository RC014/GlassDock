<local:GlassWindow x:Class="GlassDock.StatusWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:GlassDock"
                   Title="GlassDock Status">
    <Window.Resources>
        <DataTemplate x:Key="TrayIconTemplate">
            <Border Width="30" Height="30" CornerRadius="8" Margin="1,0" Background="Transparent" ToolTip="{Binding Title}"
                    MouseEnter="Tray_MouseEnter" MouseLeave="Tray_MouseLeave" MouseMove="Tray_MouseMove"
                    MouseDown="Tray_MouseDown" MouseUp="Tray_MouseUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverFill}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" MouseRightButtonUp="Bar_MouseRightButtonUp">
        <local:GlassSurface />

        <StackPanel Orientation="Horizontal" Margin="10,0">
            <!-- Hidden tray icons -->
            <Border x:Name="ChevronButton" Style="{StaticResource BarButton}" MouseLeftButtonDown="Chevron_Click" ToolTip="Show hidden icons">
                <TextBlock x:Name="ChevronGlyph" Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
            </Border>

            <!-- Tray icons the user chose to always show (Windows Settings > Taskbar > Other system tray icons) -->
            <ItemsControl x:Name="TrayList" ItemTemplate="{StaticResource TrayIconTemplate}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Network / volume / battery: click = Quick Settings, scroll = volume, middle-click = mute -->
            <Border x:Name="SystemButton" Style="{StaticResource BarButton}" Padding="10,0"
                    MouseLeftButtonUp="System_Click" MouseWheel="System_MouseWheel" MouseDown="System_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="NetGlyph" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VolGlyph" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock x:Name="BatGlyph" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                        <TextBlock x:Name="BatText" FontSize="12" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="5,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Clock: click = notifications & calendar -->
            <Border x:Name="ClockButton" Style="{StaticResource BarButton}" Padding="12,0" MouseLeftButtonUp="Clock_Click">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DateText" FontSize="11.5" Foreground="{DynamicResource FgDim}" HorizontalAlignment="Right" Margin="0,1,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Popup x:Name="OverflowPopup" PlacementTarget="{Binding ElementName=ChevronButton}" Placement="Top"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" VerticalOffset="-6">
            <Border Margin="10" Padding="6" CornerRadius="14" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
                </Border.Effect>
                <ItemsControl x:Name="OverflowList" ItemTemplate="{StaticResource TrayIconTemplate}" MaxWidth="200">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</local:GlassWindow>
