<Window x:Class="GlassDock.QuickSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GlassDock"
        Title="GlassDock Quick Settings" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" SizeToContent="Height" Width="380" UseLayoutRounding="True"
        Background="{DynamicResource MenuBg}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <CornerRadius x:Key="Radius">8</CornerRadius>

        <!-- Slim slider: rounded track, accent fill, round thumb -->
        <Style x:Key="QsSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Divider}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource QsAccent}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Fill="{DynamicResource MenuBg}" Stroke="{DynamicResource Divider}" StrokeThickness="1" />
                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource QsAccent}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="QsGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <local:GlassSurface x:Name="Glass" />

        <StackPanel Margin="16,14,16,10">
            <!-- Now playing -->
            <Grid x:Name="MediaCard" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Media_ShowPlayer">
                    <Image x:Name="MediaAppIcon" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="MediaAppName" FontSize="12" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,12,8,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Media_ShowPlayer">
                    <TextBlock x:Name="MediaTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MediaArtist" FontSize="12.5" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Grid.RowSpan="2" Width="80" Height="80" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource HoverFill}" Cursor="Hand" MouseLeftButtonUp="Media_ShowPlayer">
                    <Image x:Name="MediaArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Border Style="{StaticResource BarButton}" Padding="14,8" MouseLeftButtonUp="Media_Previous">
                        <TextBlock Text="&#xE892;" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" />
                    </Border>
                    <Border Style="{StaticResource BarButton}" Padding="14,8" Margin="12,6" MouseLeftButtonUp="Media_PlayPause">
                        <TextBlock x:Name="MediaPlayGlyph" Text="&#xE768;" Style="{StaticResource QsGlyph}" FontSize="18" Foreground="{DynamicResource Fg}" />
                    </Border>
                    <Border Style="{StaticResource BarButton}" Padding="14,8" MouseLeftButtonUp="Media_Next">
                        <TextBlock Text="&#xE893;" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" />
                    </Border>
                </StackPanel>
            </Grid>
            <Border x:Name="MediaDivider" Height="1" Background="{DynamicResource Divider}" Margin="-16,0,-16,12" />

            <!-- Tiles (filled in code) -->
            <UniformGrid x:Name="Tiles" Columns="3" />

            <Border Height="1" Background="{DynamicResource Divider}" Margin="-16,10,-16,12" />

            <!-- Sliders -->
            <DockPanel x:Name="BrightnessRow" Margin="0,2,0,8">
                <TextBlock Text="&#xE706;" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" Width="28" DockPanel.Dock="Left" />
                <Slider x:Name="BrightnessSlider" Style="{StaticResource QsSlider}" Margin="8,0,36,0" />
            </DockPanel>
            <DockPanel Margin="0,2,0,6">
                <TextBlock x:Name="VolumeGlyph" Text="&#xE767;" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" Width="28" DockPanel.Dock="Left"
                           Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Volume_ToggleMute" />
                <Border DockPanel.Dock="Right" Style="{StaticResource BarButton}" Padding="6,4" Margin="6,0,0,0" ToolTip="Sound output"
                        MouseLeftButtonUp="Volume_Output">
                    <TextBlock Text="&#xE76C;" Style="{StaticResource QsGlyph}" FontSize="12" Foreground="{DynamicResource Fg}" />
                </Border>
                <Slider x:Name="VolumeSlider" Style="{StaticResource QsSlider}" Margin="8,0,0,0" />
            </DockPanel>

            <Border Height="1" Background="{DynamicResource Divider}" Margin="-16,8,-16,8" />

            <!-- Battery and settings -->
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource BarButton}" Padding="8,6" Margin="0" ToolTip="All settings"
                        MouseLeftButtonUp="OpenAllSettings">
                    <TextBlock Text="&#xE713;" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" />
                </Border>
                <StackPanel x:Name="BatteryInfo" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                            MouseLeftButtonUp="OpenBatterySettings">
                    <TextBlock x:Name="BatteryGlyph" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" />
                    <TextBlock x:Name="BatteryText" FontSize="13" Foreground="{DynamicResource Fg}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
