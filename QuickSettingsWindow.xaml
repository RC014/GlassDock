<Window x:Class="GlassDock.QuickSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GlassDock"
        Title="GlassDock Quick Settings" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" SizeToContent="Height" Width="352" UseLayoutRounding="True"
        Background="{DynamicResource MenuBg}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <CornerRadius x:Key="Radius">8</CornerRadius>

        <!-- Slim slider: rounded track, accent fill, round thumb -->
        <Style x:Key="QsSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Divider}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource QsAccent}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Fill="{DynamicResource MenuBg}" Stroke="{DynamicResource Divider}" StrokeThickness="1" />
                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource QsAccent}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="QsGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Section title inside a slider card -->
        <Style x:Key="QsCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <!-- The backdrop (the screen behind the window, so the window itself vanishes) and on it separate pieces of
         glass with gaps between them. -->
    <Grid>
        <local:GlassSurface x:Name="Glass" />

        <Grid x:Name="Body" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Wi-Fi and Bluetooth pills (filled in code) -->
            <StackPanel x:Name="ToggleColumn" />

            <!-- Now playing -->
            <local:GlassTile x:Name="MediaCard" Grid.Column="2" CornerRadius="24" Height="130">
                <Grid Margin="14,12,14,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Media_ShowPlayer">
                        <!-- corners concentric with the card's: its radius (24) minus the art's inset (12) -->
                        <Border Width="40" Height="40" CornerRadius="12" local:RoundedClip.Radius="12" Background="{DynamicResource HoverFill}" DockPanel.Dock="Left">
                            <Image x:Name="MediaArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Image x:Name="MediaAppIcon" Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                               DockPanel.Dock="Right" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="MediaAppName" Visibility="Collapsed" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Media_ShowPlayer">
                        <TextBlock x:Name="MediaTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MediaArtist" FontSize="11.5" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <UniformGrid Grid.Row="2" Columns="3" Margin="-6,0">
                        <Border Style="{StaticResource BarButton}" Margin="0" Padding="0,5" MouseLeftButtonUp="Media_Previous">
                            <TextBlock Text="&#xE892;" Style="{StaticResource QsGlyph}" FontSize="14" Foreground="{DynamicResource Fg}" />
                        </Border>
                        <Border Style="{StaticResource BarButton}" Margin="0" Padding="0,5" MouseLeftButtonUp="Media_PlayPause">
                            <TextBlock x:Name="MediaPlayGlyph" Text="&#xE768;" Style="{StaticResource QsGlyph}" FontSize="17" Foreground="{DynamicResource Fg}" />
                        </Border>
                        <Border Style="{StaticResource BarButton}" Margin="0" Padding="0,5" MouseLeftButtonUp="Media_Next">
                            <TextBlock Text="&#xE893;" Style="{StaticResource QsGlyph}" FontSize="14" Foreground="{DynamicResource Fg}" />
                        </Border>
                    </UniformGrid>
                </Grid>
            </local:GlassTile>

            <!-- Round buttons (filled in code) -->
            <UniformGrid x:Name="Tiles" Grid.Row="1" Grid.ColumnSpan="3" Columns="4" Margin="0,10,0,0" />

            <!-- Display -->
            <local:GlassTile x:Name="BrightnessRow" Grid.Row="2" Grid.ColumnSpan="3" CornerRadius="22" Margin="0,10,0,0">
                <StackPanel Margin="16,10,16,8">
                    <TextBlock Text="Display" Style="{StaticResource QsCaption}" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="&#xE706;" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" Width="24" DockPanel.Dock="Left" />
                        <Slider x:Name="BrightnessSlider" Style="{StaticResource QsSlider}" Margin="8,0,4,0" />
                    </DockPanel>
                </StackPanel>
            </local:GlassTile>

            <!-- Sound -->
            <local:GlassTile Grid.Row="3" Grid.ColumnSpan="3" CornerRadius="22" Margin="0,10,0,0">
                <StackPanel Margin="16,10,10,8">
                    <TextBlock Text="Sound" Style="{StaticResource QsCaption}" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock x:Name="VolumeGlyph" Text="&#xE767;" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" Width="24" DockPanel.Dock="Left"
                                   Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Volume_ToggleMute" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource BarButton}" Padding="6,4" Margin="6,0,0,0" ToolTip="Sound output"
                                MouseLeftButtonUp="Volume_Output">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource QsGlyph}" FontSize="12" Foreground="{DynamicResource Fg}" />
                        </Border>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource QsSlider}" Margin="8,0,0,0" />
                    </DockPanel>
                </StackPanel>
            </local:GlassTile>

            <!-- Battery and settings -->
            <DockPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0">
                <local:GlassTile DockPanel.Dock="Right" Width="44" Height="44" CornerRadius="22" ToolTip="All settings">
                    <Border Style="{StaticResource BarButton}" Margin="0" Padding="0" CornerRadius="22" MouseLeftButtonUp="OpenAllSettings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" />
                    </Border>
                </local:GlassTile>
                <local:GlassTile x:Name="BatteryInfo" HorizontalAlignment="Left" Height="44" CornerRadius="22">
                    <Border Style="{StaticResource BarButton}" Margin="0" Padding="16,0" CornerRadius="22" MouseLeftButtonUp="OpenBatterySettings">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryGlyph" Style="{StaticResource QsGlyph}" Foreground="{DynamicResource Fg}" />
                            <TextBlock x:Name="BatteryText" FontSize="13" Foreground="{DynamicResource Fg}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </local:GlassTile>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
