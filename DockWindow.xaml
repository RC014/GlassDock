<local:GlassWindow x:Class="GlassDock.DockWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:GlassDock"
                   Title="GlassDock" AllowDrop="True">
    <Window.Resources>
        <!-- One dot per open window under a running app (up to 4): wider while the app is active, orange when it
             wants attention. -->
        <Style x:Key="IndicatorDot" TargetType="Rectangle">
            <Setter Property="Width" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Setter Property="Fill" Value="{DynamicResource Indicator}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Width" Value="7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter Property="Width" Value="5" />
                    <Setter Property="Height" Value="5" />
                    <Setter Property="RadiusX" Value="2.5" />
                    <Setter Property="RadiusY" Value="2.5" />
                    <Setter Property="Fill" Value="#FFFF9F0A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Each icon lives in an "IconHost" whose scale/offset the magnifier drives every frame. -->
        <DataTemplate x:Key="DockItemTemplate">
            <Grid x:Name="Cell" Margin="3,0"
                  MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseRightButtonUp="Item_MouseRightButtonUp"
                  MouseDown="Item_MouseDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="7" />
                </Grid.RowDefinitions>
                <Border x:Name="IconHost" Background="#01FFFFFF" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <TranslateTransform />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Image Source="{Binding Icon}" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                </Border>
                <StackPanel x:Name="Dot" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Rectangle x:Name="Dot1" Style="{StaticResource IndicatorDot}" />
                    <Rectangle x:Name="Dot2" Style="{StaticResource IndicatorDot}" Margin="3,0,0,0" Visibility="Collapsed" />
                    <Rectangle x:Name="Dot3" Style="{StaticResource IndicatorDot}" Margin="3,0,0,0" Visibility="Collapsed" />
                    <Rectangle x:Name="Dot4" Style="{StaticResource IndicatorDot}" Margin="3,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Dot" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Dot" Property="Opacity" Value="1" />
                </DataTrigger>
                <!-- one window and active: the familiar long bar -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True" />
                        <Condition Binding="{Binding WindowCount}" Value="1" />
                        <Condition Binding="{Binding IsFlashing}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Dot1" Property="Width" Value="14" />
                </MultiDataTrigger>
                <!-- one dot per open window -->
                <DataTrigger Binding="{Binding WindowCount}" Value="2">
                    <Setter TargetName="Dot2" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowCount}" Value="3">
                    <Setter TargetName="Dot2" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot3" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowCount}" Value="4">
                    <Setter TargetName="Dot2" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot3" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot4" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- App wants attention: orange indicator instead of bouncing -->
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter TargetName="Dot" Property="Opacity" Value="1" />
                </DataTrigger>

                <!-- Small hop while an app is launching -->
                <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="LaunchBounce">
                            <Storyboard RepeatBehavior="3x">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="-12"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.44" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="LaunchBounce" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Windows-style launcher glyph for the Start button -->
        <DrawingImage x:Key="StartGlyph">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000" Geometry="M0,0 H100 V100 H0 Z" />
                    <GeometryDrawing Geometry="M14,14 H48 V48 H14 Z M52,14 H86 V48 H52 Z M14,52 H48 V86 H14 Z M52,52 H86 V86 H52 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF7DD3FC" Offset="0" />
                                <GradientStop Color="#FF2563EB" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Headroom for magnified icons and the name label (transparent, click-through) -->
            <RowDefinition x:Name="HeadRow" Height="60" />
            <RowDefinition x:Name="BarRow" Height="68" />
        </Grid.RowDefinitions>

        <!-- The glass bar. Its side margins shrink while magnifying so the bar stretches with the icons. -->
        <Grid x:Name="BarBg" Grid.Row="1" MouseRightButtonUp="Bar_MouseRightButtonUp">
            <local:GlassSurface />
        </Grid>

        <StackPanel x:Name="IconStrip" Grid.Row="1" Orientation="Horizontal" Margin="9,8,9,2" HorizontalAlignment="Center"
                    MouseRightButtonUp="Bar_MouseRightButtonUp">
            <Grid x:Name="StartCell" Margin="3,0" MouseLeftButtonUp="Start_Click" MouseRightButtonUp="Start_RightClick">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="7" />
                </Grid.RowDefinitions>
                <Border x:Name="StartHost" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" CornerRadius="12"
                        VerticalAlignment="Bottom" BorderThickness="1" BorderBrush="{DynamicResource GlassRim}" Background="{DynamicResource HoverFill}"
                        RenderTransformOrigin="0.5,1">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <TranslateTransform />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Image Source="{StaticResource StartGlyph}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>

            <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource DockItemTemplate}" ItemsPanel="{StaticResource HorizontalPanel}" />

            <Border x:Name="Divider" Width="1" Margin="7,6,7,10" Background="{DynamicResource Divider}">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
            </Border>

            <ItemsControl x:Name="RunningList" ItemTemplate="{StaticResource DockItemTemplate}" ItemsPanel="{StaticResource HorizontalPanel}" />
        </StackPanel>

        <!-- App name shown above the hovered icon -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
            <Border x:Name="LabelBox" Padding="11,5" CornerRadius="9" Opacity="0"
                    Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1">
                <TextBlock x:Name="LabelText" Foreground="{DynamicResource Fg}" FontSize="12.5" />
            </Border>
        </Canvas>
    </Grid>
</local:GlassWindow>
